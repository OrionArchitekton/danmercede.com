{
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "danmercede.com"
        }
      ],
      "destination": "https://www.danmercede.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.danmercede.com/:path*",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/connect",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/connect",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal",
      "permanent": true
    },
    {
      "source": "/terms/",
      "destination": "/legal",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/thoughts",
      "permanent": true
    },
    {
      "source": "/resources/",
      "destination": "/thoughts",
      "permanent": true
    },
    {
      "source": "/readiness-scan",
      "destination": "https://www.orionintelligenceagency.com/readiness-scan",
      "permanent": true
    },
    {
      "source": "/readiness-scan/",
      "destination": "https://www.orionintelligenceagency.com/readiness-scan",
      "permanent": true
    },
    {
      "source": "/works/mcp-context-budget",
      "destination": "/works/mcp-context-budget/",
      "permanent": true
    },
    {
      "source": "/works/failclosed",
      "destination": "/works/failclosed/",
      "permanent": true
    },
    {
      "source": "/works/orion-skills",
      "destination": "/works/orion-skills/",
      "permanent": true
    },
    {
      "source": "/works/schemafit",
      "destination": "/works/schemafit/",
      "permanent": true
    },
    {
      "source": "/works/agent-demo-video",
      "destination": "/works/agent-demo-video/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/works/mcp-context-budget/",
      "destination": "https://mcp-context-budget-site.vercel.app/"
    },
    {
      "source": "/works/mcp-context-budget/:path*",
      "destination": "https://mcp-context-budget-site.vercel.app/:path*"
    },
    {
      "source": "/works/failclosed/",
      "destination": "https://failclosed-site.vercel.app/"
    },
    {
      "source": "/works/failclosed/:path*",
      "destination": "https://failclosed-site.vercel.app/:path*"
    },
    {
      "source": "/works/orion-skills/",
      "destination": "https://orion-skills-site.vercel.app/"
    },
    {
      "source": "/works/orion-skills/:path*",
      "destination": "https://orion-skills-site.vercel.app/:path*"
    },
    {
      "source": "/works/schemafit/",
      "destination": "https://schemafit-site.vercel.app/"
    },
    {
      "source": "/works/schemafit/:path*",
      "destination": "https://schemafit-site.vercel.app/:path*"
    },
    {
      "source": "/works/agent-demo-video/",
      "destination": "https://agent-demo-video-site.vercel.app/"
    },
    {
      "source": "/works/agent-demo-video/:path*",
      "destination": "https://agent-demo-video-site.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*-git-.*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/([^/]+)\\.(webp|png|jpe?g|avif|gif)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/runtime-governance/diagrams/(.*)\\.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        }
      ]
    },
    {
      "source": "/assets/runtime-governance/diagrams/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/runtime-governance/diagrams/(.*)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|webp|avif|gif|ico|map)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/guides/(.*)\\.(webp|png|jpe?g|avif|gif)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(pdf|docx|pptx|xlsx|doc|ppt|csv|zip)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
